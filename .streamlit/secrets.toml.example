# Copy to .streamlit/secrets.toml for local runs (it is gitignored), or paste
# the same keys into Settings → Secrets in Streamlit Community Cloud.

# ── Vector store (required) ──────────────────────────────────────────────────
QDRANT_URL = "https://<your-cluster>.qdrant.io"
QDRANT_API_KEY = "<qdrant api key>"
VECTOR_COLLECTION = "rishivan_docs"

# ── Vertex AI (required) ─────────────────────────────────────────────────────
# text-embedding-004 is Vertex-only, and it is what the collections above were
# built with, so this is the only backend that can query them.
GCP_PROJECT_ID = "your-project"
GCP_LOCATION = "global"
GCP_SERVICE_ACCOUNT_EMAIL = "svc@your-project.iam.gserviceaccount.com"
GCP_PRIVATE_KEY_ID = "..."
# Keep the literal \n escapes on one line, exactly as in the JSON key file:
GCP_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── MongoDB Atlas (optional) ─────────────────────────────────────────────────
# Telemetry only. Absent, the app runs exactly as before and traces go to
# ./traces/ as JSONL instead.
#
# Paste the URI as Atlas gives it to you — a password containing reserved
# characters (%, @, /, :) is percent-encoded for you in `config.MONGODB_URI`.
MONGODB_URI = "mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0"
MONGODB_DB_NAME = "rishivan_telemetry"
MONGODB_COLLECTION_NAME = "client_testing"

# The ledger defaults to "<collection>_predictions"; override only to diverge.
# MONGODB_PREDICTIONS_COLLECTION = "client_testing_predictions"

# TTL on turn documents. The free tier is 512 MB and gives no warning before it
# fills — writes just start failing. 0 disables expiry. Predictions never
# expire: one that vanishes before its window closes can never be scored.
MONGODB_RETENTION_DAYS = 90

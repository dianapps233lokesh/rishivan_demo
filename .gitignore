# Secrets — never commit. Streamlit Cloud injects these via Settings → Secrets.
.streamlit/secrets.toml
.env
*.pem
*service-account*.json
*credentials*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Extraction artefacts — regenerable, and large
koonji-*.json
koonji-*.jsonl
output*.json
logs/
data/rules-*.json
# Grading output from `python -m scripts.eval_rules --csv` — regenerated per run,
# and a committed copy goes stale the moment routing changes.
eval*.csv
